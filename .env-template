# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Optional legacy name; the agent uses AZURE_OPENAI_CHAT_DEPLOYMENT_MODEL for requests.
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT_MODEL=
AZURE_OPENAI_API_VERSION=

# SQL Server Configuration
SERVER_NAME=
DATABASE_NAME=
AUTH_METHOD=sql
SQL_USERNAME=
SQL_PASSWORD=
# Prefer true unless write tools are explicitly required (see README).
READONLY=true
CONNECTION_TIMEOUT=50
# Prefer false in production; set true only when you trust the server certificate.
TRUST_SERVER_CERTIFICATE=false

# Optional: override path to built MCP server (defaults to repo/SQL-AI-samples/.../dist/index.js)
# MCP_SERVER_SCRIPT=

# Windows/NTLM authentication (when AUTH_METHOD=windows)
# DOMAIN=
# USERNAME=
# PASSWORD=
